# Reuse the installed GIS runtime without downloading/reinstalling dependencies.
# Seed this local base image in the dedicated rootless daemon before building.
ARG GISCLAW_BASE_IMAGE=shahrkav:runtime-base
FROM ${GISCLAW_BASE_IMAGE}
ENV PROJ_DATA=/opt/conda/share/proj
COPY src/ /app/src/
COPY app/ /app/app/
