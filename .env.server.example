# Copy to .env on the server and edit these values. Never reuse the local
# development .env or commit the server's .env.
GISCLAW_DATA=/srv/shahrkav/data
GISCLAW_HTTP_PORT=18765
GISCLAW_ROOTLESS_SOCKET=/run/user/1001/docker.sock
GISCLAW_APP_IMAGE=shahrkav:isolated

# Dedicated Compose bridge. Choose an unused private subnet if this overlaps
# with a VPN, LAN, or another Docker network. The proxy gateway is trusted for
# forwarded client IP/proto headers; do not publish the app port publicly.
GISCLAW_DOCKER_SUBNET=172.31.241.0/24
GISCLAW_TRUSTED_PROXY_IP=172.31.241.1
GISCLAW_APP_IP=172.31.241.2

# Optional request deadline tuning (seconds, 1-300).
GISCLAW_LLM_TIMEOUT_SECONDS=120
